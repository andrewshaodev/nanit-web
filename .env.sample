# General configuration --------------------------------------------------------

# Writeable directory where all the files will be stored (default: /data)
# NANIT_DATA_DIR=/data

# Default value: info
# Allowed values: trace | debug | info | warn | error | fatal | panic
# NANIT_LOG_LEVEL=debug

# Web dashboard port (default: 8080)
# NANIT_HTTP_PORT=8080

# The built dashboard (default: web, relative to the working directory; the
# image keeps it at /app/web)
# NANIT_WEB_DIR=web

# Saved Nanit session (default: session.json in NANIT_DATA_DIR)
# Keeps you signed in across restarts. It contains auth tokens, so keep it
# private.
# NANIT_SESSION_FILE=/data/session.json

# Nanit credentials ------------------------------------------------------------

# Sign in from the dashboard (http://<host>:8080), which handles Nanit's 2FA.
# None of these are needed.

# Start from an existing refresh token instead of signing in
# NANIT_REFRESH_TOKEN=

# Used to sign in again if the saved session expires. They can't get past a
# 2FA prompt on their own.
# NANIT_EMAIL=
# NANIT_PASSWORD=

# Stream server ----------------------------------------------------------------

# A Nanit camera streams to one address only, so exactly one instance asks it
# to: set this on that one (default: false). Every other instance is a viewer:
# it never asks the cameras to stream, and takes the stream server's video.
# Set a viewer's stream server (host, port and key) in its dashboard under
# Settings → Streaming → Stream server. NANIT_STREAM_FROM is no longer used.
# NANIT_STREAM_SERVER=true

# Passwords are set in the dashboard, not here:
# - the dashboard password under Settings → Authentication & Security
# - the stream password (RTSP and RTMP players) under Settings → Streaming

# RTMP server ------------------------------------------------------------------

# Enable integrated RTMP server (default: true)
# NANIT_RTMP_ENABLED=true

# Ask the cam to start streaming when it comes online, and again if the stream
# drops (default: true). With false, it streams only once the dashboard is
# opened.
# NANIT_RTMP_AUTO_START=true

# Address under which this app is reachable from the cam. It can't be
# 127.0.0.1 or localhost: the cam connects to it. A host name works if the cam
# can resolve it (it uses your router's DNS). Mind the port if Docker maps it.
# Its host is also used in the RTSP links the dashboard shows.
# NANIT_RTMP_ADDR=192.168.3.234:1935

# RTSP server ------------------------------------------------------------------

# Serve each camera's stream over RTSP, for Home Assistant, Frigate, go2rtc and
# NVRs (default: true)
# NANIT_RTSP_ENABLED=true

# Where it listens (default: :8554). TCP only, so publish just this one port.
# NANIT_RTSP_ADDR=:8554

# MQTT -------------------------------------------------------------------------

# Enable MQTT integration for reading sensors data (default: false)
# NANIT_MQTT_ENABLED=true

# MQTT broker host (required if enabled)
# Examples:
# - Plain TCP: tcp://iot.eclipse.org:1883
# - Websocket: ws://my.mqtt.local or wss://my.secure.mqtt.local
# NANIT_MQTT_BROKER_URL=

# Credentials for MQTT broker (optional). Prefer these to credentials in the
# broker URL.
# NANIT_MQTT_USERNAME=
# NANIT_MQTT_PASSWORD=

# Client ID (default: nanit)
# NANIT_MQTT_CLIENT_ID=mynanit

# Topic prefix (default: nanit)
# NANIT_MQTT_PREFIX=mynanit

# Event Polling ----------------------------------------------------------------

# While Nanit doesn't provide a stream of events to subscribe to, you can poll
# the /babies/{baby_uid}/messages endpoint to retrieve the latest event messages

# Enable events polling
# NANIT_EVENTS_POLLING=true

# Interval in seconds at which to poll for new event messages (default: 30)
# NANIT_EVENTS_POLLING_INTERVAL=20

# Time in seconds after which to disregard event messages (default: 300)
# NANIT_EVENTS_MESSAGE_TIMEOUT=300

# Historical Data Tracking ----------------------------------------------------

# Enable historical data tracking (default: true)
# NANIT_HISTORY_ENABLED=true

# Days to keep historical data (default: 30)
# NANIT_HISTORY_RETENTION_DAYS=30

# Delete history older than the retention period (default: true)
# NANIT_HISTORY_CLEANUP_ENABLED=true
